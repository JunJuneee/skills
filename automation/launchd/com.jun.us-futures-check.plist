<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jun.us-futures-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jun/chikitaka/dart-insight/.venv/bin/python</string>
        <string>/Users/jun/chikitaka/dart-insight/src/krx_flow/us_futures.py</string>
