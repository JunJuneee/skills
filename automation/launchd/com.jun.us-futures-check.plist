    <key>StandardErrorPath</key>
    <string>/Users/jun/chikitaka/dart-insight/logs/us_futures_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/jun/chikitaka/dart-insight</string>
</dict>
